logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "application_logs" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/github-release-notifier-(app|notification-service)"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/github-release-notifier-(.*)"
    target_label  = "service_name"
    replacement   = "$1"
  }

  rule {
    target_label = "environment"
    replacement  = "dev"
  }
}

loki.process "application_logs" {
  stage.json {
    expressions = {
      level     = "level",
      component = "component",
    }
  }

  stage.labels {
    values = {
      level     = "",
      component = "",
    }
  }

  forward_to = [loki.write.default.receiver]
}

loki.source.docker "application_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.application_logs.output
  forward_to = [loki.process.application_logs.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
